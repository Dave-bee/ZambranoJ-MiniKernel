#include <stdio.h>
#include <stdlib.h>
#include "queue.h"

void sync_init(sync_t *s) {
    pthread_mutex_init(&(*s).mutex, NULL);
    pthread_cond_init(&(*s).condition, NULL);
}

void sync_lock(sync_t *s) {
    pthread_mutex_lock(&(*s).mutex);
}

void sync_unlock(sync_t *s) {
    pthread_mutex_unlock(&(*s).mutex);
}

void sync_wait(sync_t *s) {
    pthread_cond_wait(&(*s).condition, &(*s).mutex);
}

void sync_signal(sync_t *s) {
    pthread_cond_signal(&(*s).condition);
}

void sync_broadcast(sync_t *s) {
    pthread_cond_broadcast(&(*s).condition);
}

void sync_destroy(sync_t *s) {
    pthread_mutex_destroy(&(*s).mutex);
    pthread_cond_destroy(&(*s).condition);
}

void queue_init(ready_queue_t *q) {
    (*q).front = 0;
    (*q).rear = 0;
    (*q).size = 0;
    sync_init(&(*q).sync);
}

void queue_insert(ready_queue_t *q, pcb_t *p) {
    sync_lock(&(*q).sync);

    if ((*q).size >= MAX_PROCESSES) {
        printf("Cola llena\n", (*p).pid);
        sync_unlock(&(*q).sync);
        return;
    }

    (*p).state = READY;
    (*q).processes[(*q).rear] = p;
    (*q).rear = ((*q).rear + 1) % MAX_PROCESSES;
    (*q).size++;

    sync_signal(&(*q).sync);
    sync_unlock(&(*q).sync);
}

pcb_t *queue_remove(ready_queue_t *q) {
    sync_lock(&(*q).sync);

    while ((*q).size == 0 && simulacion_activa) {
        sync_wait(&(*q).sync);
    }

    if ((*q).size == 0) {
        sync_unlock(&(*q).sync);
        return NULL;
    }

    pcb_t *p = (*q).processes[(*q).front];
    (*q).front = ((*q).front + 1) % MAX_PROCESSES;
    (*q).size--;
    (*p).state = RUNNING;

    sync_unlock(&(*q).sync);
    return p;
}

int queue_empty(ready_queue_t *q) {
    sync_lock(&(*q).sync);
    int empty = ((*q).size == 0);
    sync_unlock(&(*q).sync);
    return empty;
}

void queue_destroy(ready_queue_t *q) {
    sync_destroy(&(*q).sync);
}
