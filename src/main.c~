#include <stdio.h>
#include <stdlib.h>
#include <math.h>
#include <unistd.h>
#include <pthread.h>
#include <time.h>
#include "pcb.h"
#include "queue.h"
#include "metrics.h"
#include "sync.h"

#define N_CPUS 3
#define N_PROCESOS 10

ready_queue_t ready_queue;
metrics_t metrics;
int simulacion_activa = 1;
int pid_counter = 1;
sync_t print_lock;

void *cpu_run(void *arg);

int poisson(double lambda) {
    double L = exp(-lambda);
    double p = 1.0;
    int k = 0;
    do {
        k++;
        p = p * ((double)rand() / RAND_MAX);
    } while (p > L);
    return k - 1;
}

void *proceso_generator(void *arg) {
    int i;
    pcb_t *p;

    for (i = 0; i < N_PROCESOS; i++) {
        sleep(poisson(2) + 1);

        p = (pcb_t *)malloc(sizeof(pcb_t));
        if (p == NULL) {
            printf("error: no se pudo crear proceso\n");
            continue;
        }

        (*p).pid = pid_counter++;
        (*p).burst_time = poisson(4) + 1;
        (*p).remaining_time = (*p).burst_time;
        (*p).priority = rand() % 5 + 1;
        (*p).arrival_time = i;
        (*p).state = NEW;

        sync_lock(&print_lock);
        printf("[GENERATOR] pid:%d burst:%d arrival:%d\n",
            (*p).pid, (*p).burst_time, (*p).arrival_time);
        sync_unlock(&print_lock);

        queue_insert(&ready_queue, p);
    }

    sync_lock(&print_lock);
    printf("[GENERATOR] all processes created\n");
    sync_unlock(&print_lock);

    return NULL;
}

void *metrics_run(void *arg) {
    int last_total = 0;

    while (simulacion_activa) {
        sleep(2);
        // solo imprime si hay nuevos procesos terminados
        if (metrics.total > last_total) {
            last_total = metrics.total;
            metrics_calculate(&metrics, N_PROCESOS);
            sync_lock(&print_lock);
            printf("[METRICS] processes done:%d | avg response:%.2f | throughput:%.2f\n",
                metrics.total,
                metrics.avg_response_time,
                metrics.throughput);
            sync_unlock(&print_lock);
        }
    }
    return NULL;
}

int main() {
    int i;
    pthread_t cpu_threads[N_CPUS];
    pthread_t generator_thread;
    pthread_t metrics_thread;
    int cpu_ids[N_CPUS];

    srand(time(NULL));
    queue_init(&ready_queue);
    metrics_init(&metrics);
    sync_init(&print_lock);

    printf("========== MINIKERNEL ==========\n");
    printf("CPUs: %d | processes: %d | quantum: 2\n\n", N_CPUS, N_PROCESOS);

    if (pthread_create(&generator_thread, NULL, proceso_generator, NULL) != 0) {
        printf("error: generator thread failed\n");
        return 1;
    }

    for (i = 0; i < N_CPUS; i++) {
        cpu_ids[i] = i;
        if (pthread_create(&cpu_threads[i], NULL, cpu_run, &cpu_ids[i]) != 0) {
            printf("error: cpu thread %d failed\n", i);
            return 1;
        }
    }

    if (pthread_create(&metrics_thread, NULL, metrics_run, NULL) != 0) {
        printf("error: metrics thread failed\n");
        return 1;
    }

    pthread_join(generator_thread, NULL);
    sleep(20);

    simulacion_activa = 0;
    sync_broadcast(&ready_queue.sync);

    for (i = 0; i < N_CPUS; i++) {
        pthread_join(cpu_threads[i], NULL);
    }

    pthread_join(metrics_thread, NULL);

    metrics_calculate(&metrics, N_PROCESOS);
    metrics_print(&metrics);

    queue_destroy(&ready_queue);
    sync_destroy(&print_lock);

    printf("================================\n");
    return 0;
}
